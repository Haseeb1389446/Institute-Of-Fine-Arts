@{
}

<main class="student-dashboard">

    <!-- Dashboard Header -->
    <section class="student-header">
        <div>
            <span class="dashboard-label">
                <i class="fas fa-graduation-cap"></i> STUDENT PORTAL
            </span>

            <h1>Welcome, @(User.Identity!.Name)</h1>

            <p>
                Manage your paintings, competitions, exhibitions and achievements.
            </p>
        </div>

        <div class="student-avatar">
            <i class="fas fa-user"></i>
        </div>
    </section>


    <!-- Quick Stats -->
    <section class="student-stats">

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-palette"></i>
            </div>
            <div>
                <span>Total Paintings</span>
                <strong>@Model.Paintings.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <div>
                <span>Competitions</span>
                <strong>@Model.Competitions.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-award"></i>
            </div>
            <div>
                <span>Awards Won</span>
                <strong>@Model.Awards.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-image"></i>
            </div>
            <div>
                <span>Exhibitions</span>
                <strong>@Model.Exhibitions.Count</strong>
            </div>
        </div>

    </section>


    <!-- Upcoming Competitions -->
    <section class="student-panel">

        <div class="panel-header">
            <div>
                <span class="panel-label">OPPORTUNITIES</span>
                <h2>Upcoming Competitions</h2>
            </div>

            <a asp-controller="Home"
               asp-action="Competitions"
               class="panel-link">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="competition-list">

            @if (ViewBag.upcoming != null && ViewBag.upcoming.Count > 0)
            {
                @foreach (var competition in ViewBag.upcoming)
                {
                    <div class="competition-item">
                        <div class="competition-date">
                            <strong>@competition.StartDate.Day</strong>
                            <span>@competition.StartDate.ToString("MMM")</span>
                        </div>

                        <div class="competition-info">
                            <h4>@competition.Title</h4>

                            <p>
                                <i class="far fa-calendar"></i>
                                @competition.StartDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>

                        <span class="status-badge upcoming">
                            Upcoming
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-trophy"></i>
                    </div>

                    <h4>No Upcoming Competitions</h4>

                    <p>
                        There are currently no upcoming competitions available.
                        Check back later for new opportunities.
                    </p>
                </div>
            }

        </div>

    </section>


    <!-- My Paintings -->
    <section class="student-panel">

        <div class="panel-header">
            <div>
                <span class="panel-label">PORTFOLIO</span>
                <h2>My Paintings</h2>
            </div>

            <a asp-controller="Home"
               asp-action="SubmitPaintings"
               class="primary-action">
                <i class="fas fa-plus"></i>
                Upload Painting
            </a>
        </div>


        <div class="painting-table-wrapper">

            <table class="student-table">

                <thead>
                    <tr>
                        <th>Painting</th>
                        <th>Description</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Paintings != null && Model.Paintings.Count > 0)
                    {
                        @foreach (var painting in Model.Paintings)
                        {
                            <tr>
                                <td>
                                    <div class="painting-name">

                                        <div class="painting-icon">
                                            @if (!string.IsNullOrEmpty(painting.PaintingImage))
                                            {
                                                <img src="~/Uploads/paintings/@painting.PaintingImage"
                                                     height="60"
                                                     width="60"
                                                     alt="@painting.PaintingName" />
                                            }
                                            else
                                            {
                                                <div class="no-image">
                                                    <i class="fas fa-palette"></i>
                                                </div>
                                            }
                                    </div>

                                    <strong>@painting.PaintingName</strong>

                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(painting.Description)
                                                            ? "No description available"
                                                            : painting.Description)
                        </td>

                                <td>
                                    @painting.DatePosted.ToString("MMMM dd, yyyy")
                                </td>

                                <td>
                                    <span class="table-status">
                                        Submitted
                                    </span>
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a class="action-btn"
                                           asp-controller="Home"
                                           asp-action="PaintingDetails"
                                           asp-route-id="@painting.Id">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="action-btn"
                                           asp-controller="Home"
                                           asp-action="UpdatePainting"
                                           asp-route-id="@painting.Id">
                                            <i class="fas fa-pen"></i>
                                        </a>

                                        <a class="action-btn delete"
                                           asp-controller="Home"
                                           asp-action="DeletePainting"
                                           asp-route-id="@painting.Id">
                                            <i class="fas fa-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        <i class="fas fa-palette"></i>
                                    </div>

                                    <h4>No Paintings Yet</h4>

                                    <p>
                                        You haven't submitted any artwork yet.
                                    </p>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>


    <!-- Two Column Area -->
    <div class="student-grid">

        <!-- Awards -->
        <section class="student-panel">

            <div class="panel-header">
                <div>
                    <span class="panel-label">ACHIEVEMENTS</span>
                    <h2>My Awards</h2>
                </div>

                <i class="fas fa-award panel-heading-icon"></i>
            </div>

            <div class="award-list">

                @if (Model.Awards != null && Model.Awards.Count > 0)
                {
                    @foreach (var award in Model.Awards)
                    {
                        <div class="award-item">

                            <div class="award-icon">
                                <i class="fas fa-trophy"></i>
                            </div>

                            <div>
                                <h4>@award.AwardTitle</h4>

                                <p>
                                    @(award.Competition?.Title ?? "Competition not assigned")
                                </p>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state compact">

                        <div class="empty-state-icon">
                            <i class="fas fa-award"></i>
                        </div>

                        <h4>No Awards Yet</h4>

                        <p>
                            Your achievements and awards will appear here.
                        </p>

                    </div>
                }

            </div>

        </section>


        <!-- Feedback -->
        <section class="student-panel">

            <div class="panel-header">
                <div>
                    <span class="panel-label">REVIEWS</span>
                    <h2>Recent Feedback</h2>
                </div>

                <i class="fas fa-comment-dots panel-heading-icon"></i>
            </div>

            @if (Model.Paintings != null && Model.Paintings.Count > 0)
            {
                @foreach (var remark in Model.Paintings)
                {
                    <div class="feedback-modern">

                        <div class="feedback-top">
                            <strong>
                                @remark.PaintingName
                            </strong>
                        </div>

                        <p>
                            @(string.IsNullOrEmpty(remark.Description)
                                                ? "No feedback available yet."
                                                : remark.Description)
                </p>

                    </div>
                        }
            }
            else
            {
                <div class="empty-state compact">

                    <div class="empty-state-icon">
                        <i class="fas fa-comment-dots"></i>
                    </div>

                    <h4>No Feedback Yet</h4>

                    <p>
                        Staff feedback and remarks will appear here after your artwork is reviewed.
                    </p>

                </div>
            }

        </section>

    </div>


    <!-- Exhibition Status -->
    <section class="student-panel">

        <div class="panel-header">

            <div>
                <span class="panel-label">EXHIBITIONS</span>
                <h2>Exhibition Status</h2>
            </div>

            <a asp-controller="Home"
               asp-action="Exhibitions"
               class="panel-link">
                Explore Exhibitions
                <i class="fas fa-arrow-right"></i>
            </a>

        </div>


        <div class="painting-table-wrapper">

            <table class="student-table">

                <thead>
                    <tr>
                        <th>Painting</th>
                        <th>Exhibition</th>
                        <th>Status</th>
                        <th>Buyer</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <strong>Sunset Dreams</strong>
                        </td>

                        <td>Summer Arts 2025</td>

                        <td>
                            <span class="table-status sold">
                                Sold
                            </span>
                        </td>

                        <td>Jane Doe</td>
                    </tr>

                    <tr>
                        <td>
                            <strong>City Lights</strong>
                        </td>

                        <td>Modern Art Fiesta</td>

                        <td>
                            <span class="table-status unsold">
                                Unsold
                            </span>
                        </td>

                        <td>—</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>

</main>