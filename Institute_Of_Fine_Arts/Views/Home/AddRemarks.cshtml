@model Painting

@{
    ViewData["Title"] = "Review Artwork";
}

<main class="review-page">

    <!-- Header -->
    <section class="review-header">
        <div class="container">

            <a asp-controller="Home"
               asp-action="ViewPaintings"
               class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Artworks
            </a>

            <div class="review-heading">
                <div>
                    <span class="eyebrow">STAFF REVIEW</span>
                    <h1>Review Artwork</h1>
                    <p>
                        Evaluate the student's artwork and provide professional feedback.
                    </p>
                </div>

                <div class="review-badge">
                    <i class="fas fa-palette"></i>
                    Artwork Evaluation
                </div>
            </div>

        </div>
    </section>


    <!-- Review Content -->
    <section class="review-section">
        <div class="container">

            <div class="review-grid">

                <!-- Artwork Preview -->
                <div class="artwork-preview-card">

                    <div class="preview-header">
                        <span>ARTWORK PREVIEW</span>
                        <i class="fas fa-image"></i>
                    </div>

                    <div class="artwork-image-wrapper">

                        @if (!(string.IsNullOrEmpty(Model.PaintingImage)))
                        {
                            <img src="~/Uploads/paintings/@Model.PaintingImage"
                                 alt="@Model.PaintingName"
                                 class="artwork-preview-image" />
                        }
                        else
                        {
                            <div class="no-artwork">
                                <i class="fas fa-image"></i>
                                <p>No artwork image available</p>
                            </div>
                        }

                    </div>

                    <div class="artwork-basic-info">

                        <span class="info-label">ARTWORK TITLE</span>
                        <h2>@Model.PaintingName</h2>

                        <div class="artist-info">
                            <div class="artist-avatar">
                                <i class="fas fa-user"></i>
                            </div>

                            <div>
                                <span>STUDENT</span>
                                <strong>
                                    @(Model.Student!.UserName ?? "Unknown Student")
                                </strong>
                            </div>
                        </div>

                    </div>

                </div>


                <!-- Review Form -->
                <div class="review-form-card">

                    <div class="form-card-header">
                        <div class="header-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>

                        <div>
                            <h2>Artwork Evaluation</h2>
                            <p>Provide your assessment below.</p>
                        </div>
                    </div>


                    <form method="post"
                          asp-controller="Home"
                          asp-action="AddRemarks">

                        <input type="hidden" asp-for="Id" />


                        <!-- Competition -->
                        <div class="info-box">

                            <div class="info-box-icon">
                                <i class="fas fa-trophy"></i>
                            </div>

                            <div>
                                <span>COMPETITION</span>

                                <strong>
                                    @(Model.Competition!.Title ?? "Not Assigned")
                                </strong>
                            </div>

                        </div>


                        <!-- Grade -->
                        <div class="form-group">

                            <label asp-for="Creativity">
                                <i class="fas fa-star"></i>
                                Creativity
                            </label>

                            <select asp-for="Creativity" class="modern-input">

                                <option value="">
                                    Select Creativity Level
                                </option>

                                <option value="Best">Best</option>
                                <option value="Better">Better</option>
                                <option value="Good">Good</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Normal">Normal</option>
                            </select>

                            <span asp-validation-for="Creativity"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- Remarks -->
                        <div class="form-group">

                            <label asp-for="Remarks">
                                <i class="fas fa-comment-dots"></i>
                                Staff Remarks
                            </label>

                            <textarea asp-for="Remarks"
                                      class="modern-input modern-textarea"
                                      rows="6"
                                      placeholder="Write constructive feedback about the student's artwork..."></textarea>

                            <div class="textarea-footer">
                                <span>
                                    <i class="fas fa-lightbulb"></i>
                                    Keep your feedback constructive and specific.
                                </span>
                            </div>

                                <span asp-validation-for="Remarks"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- Review Summary -->
                        <div class="review-note">

                            <i class="fas fa-info-circle"></i>

                            <div>
                                <strong>Review Guidelines</strong>

                                <p>
                                    Consider creativity, composition, originality,
                                    color usage and overall presentation when
                                    evaluating the artwork.
                                </p>
                            </div>

                        </div>


                        <!-- Buttons -->
                        <div class="form-actions">

                            <a asp-controller="Home"
                               asp-action="ViewPaintings"
                               class="cancel-btn">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="submit-review-btn">

                                <i class="fas fa-check"></i>
                                Submit Review

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </section>

</main>