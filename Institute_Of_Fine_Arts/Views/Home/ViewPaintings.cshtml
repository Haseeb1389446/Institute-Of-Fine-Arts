@{
}

@model List<Painting>;

<main class="paintings-page">

    <!-- Page Header -->
    <section class="paintings-hero">
        <div class="container">
            <span class="page-label">ART COLLECTION</span>
            <h1>All Art Submissions</h1>
            <p>
                Explore creative artworks submitted by talented artists
                from our competitions and exhibitions.
            </p>
        </div>
    </section>


    <!-- Paintings Section -->
    <section class="paintings-section">
        <div class="container">

            <div class="section-heading">
                <div>
                    <span>FEATURED COLLECTION</span>
                    <h2>Submitted Artworks</h2>
                </div>

                <div class="art-count">
                    <strong>@Model.Count</strong>
                    <small>Artworks</small>
                </div>
            </div>

    @foreach (var painting in Model)
    {
            <!-- Painting Card -->
            <article class="artwork-card">

                <div class="artwork-image">
                    <img src="~/uploads/paintings/@painting.PaintingImage" alt="Artwork by @painting.Student!.UserName">

                    <div class="artwork-badge">
                        <i class="fas fa-palette"></i>
                        Art Submission
                    </div>
                </div>

                <div class="artwork-content">

                    <div class="artwork-meta">
                        <span>
                            <i class="fas fa-trophy"></i>
                                @painting.Competition!.Title
                        </span>

                        <span>
                            <i class="far fa-calendar"></i>
                                @painting.DatePosted.ToString("MMMM dd, yyyy")
                        </span>
                    </div>

                    <h3>@painting.PaintingName</h3>

                    <div class="artist-info">
                        <div class="artist-avatar">
                                @painting.Student!.UserName!.Substring(0, 1).ToUpper()
                        </div>

                        <div>
                            <small>ARTIST</small>
                            <strong>@painting.Student!.UserName</strong>
                        </div>
                    </div>

                    <p class="artwork-description">
                            @painting.Description
                    </p>

                    <div class="artwork-details">

                        <div>
                            <span>Creativity</span>
                            <strong class="grade">@(painting.Creativity ?? "Not Assigned Yet")</strong>
                        </div>

                        <div>
                            <span>Review Status</span>
                                    @if (painting.Remarks != null)
                                    {
                                        <strong class="status-approved">
                                            <i class="fas fa-check-circle"></i>
                                            Reviewed
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="status-approved">
                                            <i class="fa-regular fa-circle"></i>
                                            Pending
                                        </strong>
                                    }
                        </div>

                    </div>

                    <div class="remarks">
                        <i class="fas fa-quote-left"></i>

                        <div>
                            <small>JUDGE'S REMARKS</small>
                            <p>
                                    @(painting.Remarks ?? "No remarks provided yet.")
                            </p>
                        </div>
                    </div>

                    <button class="artwork-btn">
                        <a asp-controller="Home" asp-action="PaintingDetails" asp-route-id="@painting.Id">
                        <i class="fas fa-eye"></i>
                        View Artwork
                        </a>
                    </button>

                </div>
            </article>
    }

        </div>
    </section>

</main>